# ── Core ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/airesume_dev
REDIS_URL=redis://localhost:6379

# better-auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set "true" in production; dev defaults to auto-verified accounts
REQUIRE_EMAIL_VERIFICATION=false

# ── Storage ─────────────────────────────────────────────────────────────
# local (dev + shift-plan worker) | cloudinary | s3 (managed AWS path).
# Relative local paths are anchored to the repo root, so web and worker
# always agree on the location.
STORAGE_DRIVER=local
LOCAL_EXPORTS_DIR=./.data/exports
S3_EXPORTS_BUCKET=
S3_REGION=ap-south-1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Worker download server (shift plan) ─────────────────────────────────
# The web proxies PDF downloads from the EC2 worker through a signed URL.
# INTERNAL_TOKEN must match on web + worker; WORKER_DOWNLOAD_URL is web-only.
INTERNAL_TOKEN=
WORKER_PORT=3001
WORKER_DOWNLOAD_URL=

# ── OAuth (optional; buttons hidden when unset) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH=false
NEXT_PUBLIC_GITHUB_OAUTH=false

# ── AWS (prod only) ─────────────────────────────────────────────────────
# SES for transactional email is configured via IAM role in production.
